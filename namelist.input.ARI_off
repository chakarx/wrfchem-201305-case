! See README.md: published settings and implementation choices are listed separately.
! Run geogrid -> ungrib -> metgrid -> real again; old 27 km wrfinput cannot be reused.
&time_control
 run_days = 2,
 run_hours = 0,
 start_year = 2013, 2013,
 start_month = 5, 5,
 start_day = 1, 1,
 start_hour = 0, 0,
 start_minute = 0, 0,
 start_second = 0, 0,
 end_year = 2013, 2013,
 end_month = 5, 5,
 end_day = 3, 3,
 end_hour = 0, 0,
 end_minute = 0, 0,
 end_second = 0, 0,
 interval_seconds = 21600,
 input_from_file = .true., .true.,
 history_interval = 60, 60,
 frames_per_outfile = 1, 1,
 restart = .false.,
 restart_interval = 1440,
 io_form_history = 2,
 io_form_restart = 2,
 io_form_input = 2,
 io_form_boundary = 2,
 auxinput1_inname = 'met_em.d<domain>.<date>',
 auxinput4_inname = 'wrflowinp_d<domain>',
 auxinput4_interval = 360, 360,
 io_form_auxinput4 = 2,
 auxinput5_inname = 'wrfchemi_d<domain>_<date>',
 auxinput5_interval_m = 60, 60,
 frames_per_auxinput5 = 1, 1,
 io_form_auxinput5 = 2,
 auxinput6_inname = 'wrfbiochemi_d<domain>',
 io_form_auxinput6 = 2,
 debug_level = 0,
/
&domains
 time_step = 120,
 time_step_fract_num = 0,
 time_step_fract_den = 1,
 max_dom = 2,
 e_we = 91, 160,
 e_sn = 73, 145,
 e_vert = 36, 36,
 dx = 60000, 20000,
 dy = 60000, 20000,
 p_top_requested = 5000,
 num_metgrid_levels = 38,
 num_metgrid_soil_levels = 4,
 grid_id = 1, 2,
 parent_id = 0, 1,
 i_parent_start = 1, 26,
 j_parent_start = 1, 13,
 parent_grid_ratio = 1, 3,
 parent_time_step_ratio = 1, 3,
 feedback = 0,
 smooth_option = 0,
 ! 36 interfaces -> 35 mass layers. Low-level density must be checked in real output.
 eta_levels = 1.0, .9985, .997, .995, .9925, .99, .987, .9835, .9795,
              .975, .970, .964, .956, .945, .931, .912, .887, .855,
              .817, .773, .723, .667, .605, .538, .467, .394, .321,
              .252, .190, .138, .095, .060, .033, .014, .004, 0.0,
 interp_type = 2,
 lowest_lev_from_sfc = .false.,
 t_extrap_type = 2,
 force_sfc_in_vinterp = 6,
 use_levels_below_ground = .true.,
 use_surface = .true.,
 lagrange_order = 1,
 rh2qv_method = 2,
 adjust_heights = .true.,
/
&physics
 mp_physics = 2, 2,
 progn = 0, 0,
 ra_lw_physics = 4, 4,
 ra_sw_physics = 4, 4,
 radt = 20, 20,
 sf_sfclay_physics = 1, 1,
 sf_surface_physics = 2, 2,
 bl_pbl_physics = 1, 1,
 bldt = 0, 0,
 cu_physics = 3, 3,
 cudt = 0, 0,
 isfflx = 1,
 ifsnow = 1,
 icloud = 1,
 surface_input_source = 3,
 num_soil_layers = 4,
 num_land_cat = 24,
 sf_urban_physics = 0, 0,
 mp_zero_out = 2,
 maxiens = 1,
 maxens = 3,
 maxens2 = 3,
 maxens3 = 16,
 ensdim = 144,
 cu_rad_feedback = .true.,
 topo_wind = 0,
 usemonalb = .true.,
 sst_update = 1,
/
&fdda
 ! No observation assimilation for the paired ARI simulations described in Methods.
 grid_fdda = 0, 0,
 obs_nudge_opt = 0, 0,
/
&dynamics
 w_damping = 1,
 diff_opt = 1, 1,
 km_opt = 4, 4,
 diff_6th_opt = 0, 0,
 base_temp = 290.,
 damp_opt = 0,
 zdamp = 5000., 5000.,
 dampcoef = .2, .2,
 khdif = 0, 0,
 kvdif = 0, 0,
 non_hydrostatic = .true., .true.,
 moist_adv_opt = 2, 2,
 scalar_adv_opt = 2, 2,
 chem_adv_opt = 2, 2,
 tke_adv_opt = 2, 2,
 gwd_opt = 0,
/
&bdy_control
 spec_bdy_width = 5,
 spec_zone = 1,
 relax_zone = 4,
 specified = .true., .false.,
 nested = .false., .true.,
/
&grib2
/
&chem
 ! Implementation choice: four-bin aqueous CBM-Z/MOSAIC. Paper did not disclose bin count.
 chem_opt = 9, 9,
 kemit = 4,
 chemdt = 2., 2.,
 ! Supported RADM2/SORGAM input -> CBM-Z/MOSAIC conversion in local source.
 emiss_opt = 3, 3,
 emiss_inpt_opt = 1, 1,
 io_style_emissions = 2,
 chem_in_opt = 0, 0,
 phot_opt = 2, 2,
 photdt = 2., 2.,
 gas_drydep_opt = 1, 1,
 aer_drydep_opt = 1, 1,
 bio_emiss_opt = 3, 3,
 bioemdt = 30, 30,
 biomass_burn_opt = 0, 0,
 ! Local MOSAIC-compatible GOCART implementation (module_mosaic_addemiss.F).
 dust_opt = 13,
 dmsemis_opt = 0,
 seas_opt = 2,
 aer_op_opt = 1,
 opt_pars_out = 1,
 gas_bc_opt = 1, 1,
 gas_ic_opt = 1, 1,
 aer_bc_opt = 1, 1,
 aer_ic_opt = 1, 1,
 ! No external chemistry BC supplied: use model profiles until BC preprocessing is provided.
 have_bcs_chem = .false., .false.,
 gaschem_onoff = 1, 1,
 aerchem_onoff = 1, 1,
 wetscav_onoff = 1, 1,
 cldchem_onoff = 1, 1,
 vertmix_onoff = 1, 1,
 chem_conv_tr = 1, 1,
 conv_tr_wetscav = 1, 1,
 conv_tr_aqchem = 1, 1,
 aer_ra_feedback = 0, 0,
 ne_area = 500,
/
&namelist_quilt
 nio_tasks_per_group = 0,
 nio_groups = 1,
/
