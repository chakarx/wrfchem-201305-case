! Huang et al. 2020: 60/20 km nests. Dates are the user's May 2013 case.
! Exact domain bounds were not published: counts/placement below are an implementation choice.
&share
 wrf_core = 'ARW',
 max_dom = 2,
 start_date = '2013-05-01_00:00:00', '2013-05-01_00:00:00',
 end_date = '2013-05-03_00:00:00', '2013-05-03_00:00:00',
 interval_seconds = 21600,
 io_form_geogrid = 2,
/
&geogrid
 parent_id = 1, 1,
 parent_grid_ratio = 1, 3,
 i_parent_start = 1, 26,
 j_parent_start = 1, 13,
 e_we = 91, 160,
 e_sn = 73, 145,
 geog_data_res = 'glc2015_30s', 'glc2015_30s',
 dx = 60000,
 dy = 60000,
 map_proj = 'lambert',
 ref_lat = 36.0,
 ref_lon = 103.0,
 truelat1 = 25.0,
 truelat2 = 40.0,
 stand_lon = 110.0,
 geog_data_path = '/data/caojc/wrf_input/WPS_GEOG/',
/
&ungrib
 out_format = 'WPS',
 prefix = 'FILE',
/
&metgrid
 fg_name = 'FILE',
 io_form_metgrid = 2,
/
